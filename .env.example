# Database Configuration
# Connection string format: postgresql://user:password@host:port/database
# For Supabase: postgresql://postgres:password@db.supabasehost.com:5432/postgres
# For local development: postgresql://postgres:password@localhost:5432/spk
DATABASE_URL=

# BetterAuth Configuration
# Secret key for signing tokens (generate with: openssl rand -hex 32)
BETTER_AUTH_SECRET=

# BetterAuth URL (base URL of your application)
# For local development: http://localhost:3000
# For production: https://yourdomain.com
BETTER_AUTH_URL=

# Node Environment
# Options: development, production, test
NODE_ENV=development

N8N_RANKING_WEBHOOK_URL=
